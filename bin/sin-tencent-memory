#!/usr/bin/env python3
"""Explicit read-only CLI for the optional TencentDB Agent Memory provider."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

from sin_tencent_memory import (  # noqa: E402
    DEFAULT_CONFIG,
    TencentMemoryClient,
    TencentMemoryConfig,
    TencentMemoryError,
)


def render(value: object) -> None:
    print(json.dumps(value, indent=2, ensure_ascii=False, sort_keys=True))


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="sin-tencent-memory",
        description="Safe read-only TencentDB Agent Memory MemoryCore v3 adapter",
    )
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status")
    subparsers.add_parser("health")

    search = subparsers.add_parser("search")
    search.add_argument("query")
    search.add_argument("--limit", type=int, default=5)

    subparsers.add_parser("scenarios")
    args = parser.parse_args()

    try:
        config = TencentMemoryConfig.load(args.config)
        client = TencentMemoryClient(config)
        if args.command == "status":
            render(client.sanitized_status())
        elif args.command == "health":
            render(client.health())
        elif args.command == "search":
            render(client.search_atomic(args.query, limit=args.limit))
        elif args.command == "scenarios":
            render(client.list_scenarios())
        else:  # pragma: no cover - argparse guarantees this
            parser.error("unsupported command")
        return 0
    except (TencentMemoryError, ValueError, OSError, json.JSONDecodeError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
