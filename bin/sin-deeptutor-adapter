#!/usr/bin/env python3
"""CLI adapter exposing DeepTutor-style research decomposition as JSON."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LIB = ROOT / "lib"
if str(LIB) not in sys.path:
    sys.path.insert(0, str(LIB))

from sin_context.deeptutor_adapter import build_deeptutor_context  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("question", nargs="+")
    parser.add_argument(
        "--subquestion",
        action="append",
        default=[],
        help="append a dynamic subquestion to the initial research plan",
    )
    args = parser.parse_args()

    try:
        packet = build_deeptutor_context(
            " ".join(args.question),
            dynamic_subquestions=args.subquestion,
        )
    except ValueError as error:
        print(str(error), file=sys.stderr)
        return 2

    print(json.dumps(packet, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
