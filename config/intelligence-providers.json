{
  "version": 1,
  "providers": {
    "symbol_navigation": {
      "primary": "gitnexus"
    },
    "general_code_graph": {
      "primary": "gitnexus",
      "allow_simultaneous_execution": false
    },
    "change_review": {
      "primary": "code-review-graph",
      "supplementary": [
        "sin-code-intent-based-diffing"
      ]
    },
    "verification": {
      "primary": "sin-code-verification-oracle",
      "supplementary": [
        "repository-native-tests",
        "typechecker",
        "linter"
      ]
    },
    "project_memory": {
      "primary": "openviking"
    },
    "session_resume": {
      "primary": "session-digest"
    },
    "mixed_corpus_graph": {
      "primary": "graphify",
      "automatic": false,
      "scope": "explicit mixed code+docs or cross-repository corpus queries only"
    },
    "code_orientation": {
      "primary": "graft",
      "automatic": false,
      "scope": "semantic codebase orientation and compressed subsystem explanation; never code-impact ground truth"
    }
  },
  "rules": {
    "never_run_graphify_and_gitnexus_for_the_same_query": true,
    "never_treat_graph_risk_as_ground_truth": true,
    "never_accept_code_without_controller_verification": true,
    "never_expose_raw_worker_transcripts_to_codex": true,
    "never_install_external_mcp_integrations_automatically": true,
    "gitnexus_is_canonical_code_intelligence": true,
    "graphify_is_never_automatic_code_graph_fallback": true,
    "openviking_is_canonical_domain_memory": true,
    "legacy_memory_projections_are_never_automatic": true,
    "graft_is_orientation_not_code_truth": true,
    "graft_never_owns_durable_memory": true,
    "sin_code_is_verification_not_context_graph": true
  }
}
